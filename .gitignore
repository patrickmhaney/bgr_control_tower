# --- Python ---------------------------------------------------------------
.venv/
venv/
# Root only: infra/env/ holds the per-environment Bicep parameters, which are committed.
/env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# --- dbt ------------------------------------------------------------------
target/
dbt_packages/
logs/
# dbt writes an anonymous install id here; it is per-machine, not per-project.
.user.yml

# --- Pipeline data --------------------------------------------------------
# Everything the pipeline produces lives under .data/ and is reproducible with
# `make mock run`. .blocked_words holds the words the blocked-word check rejects;
# it must never be committed.
.data/
*.duckdb
*.duckdb.wal
transform/target/
transform/dbt_packages/
transform/logs/
.blocked_words

# --- Dagster ---------------------------------------------------------------
# `dagster dev` keeps its run history in a temporary home in the working
# directory, or under DAGSTER_HOME when that points at orchestration/.
.tmp_dagster_home_*/
orchestration/storage/
orchestration/history/
orchestration/schedules/

# --- Power BI -------------------------------------------------------------
# Desktop writes per-user settings and a data cache beside a Power BI Project;
# the model and report definitions are committed, these are not.
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix

# --- Secrets and local config ---------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json
# Claude Code's per-user permissions; .claude/skills/ is shared.
.claude/settings.local.json

# --- Editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
