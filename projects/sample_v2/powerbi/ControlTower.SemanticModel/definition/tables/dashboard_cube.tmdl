table dashboard_cube

	/// The share of delivered order lines that arrived on or before the date the customer requested. Lines still in transit are outside the denominator. Rolls up as: ratio.
	measure 'On-Time Delivery' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[on_time_deliveries]), SUM('dashboard_cube'[delivered_lines])))
		formatString: 0.0%
		displayFolder: KPIs

	/// Delivered quantity as a share of ordered quantity, on orders that were not cancelled. Rolls up as: ratio.
	measure 'Order Fill Rate' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[delivered_quantity]), SUM('dashboard_cube'[ordered_quantity])))
		formatString: 0.0%
		displayFolder: KPIs

	/// Credit value of customer returns as a share of invoiced value, dated on the order. Rolls up as: ratio.
	measure 'Return Rate' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[returned_value]), SUM('dashboard_cube'[invoiced_value])))
		formatString: 0.0%
		displayFolder: KPIs

	/// Average days from invoice to payment, over settled invoice lines. Rolls up as: ratio.
	measure 'DSO (days-to-pay proxy)' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[days_to_pay_total]), SUM('dashboard_cube'[settled_invoice_lines])))
		formatString: #,0.0
		displayFolder: KPIs

	/// The share of invoice lines not yet paid. The companion DSO needs. Rolls up as: ratio.
	measure 'Unsettled Invoice Rate' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[unsettled_invoice_lines]), SUM('dashboard_cube'[invoice_lines])))
		formatString: 0.0%
		displayFolder: KPIs

	/// The share of supplier invoice lines that agree with the purchase order and the receipt. Rolls up as: ratio.
	measure 'Match Rate' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[matched_supplier_invoice_lines]), SUM('dashboard_cube'[supplier_invoice_lines])))
		formatString: 0.0%
		displayFolder: KPIs

	/// The share of counted stock positions whose count matched the system quantity. Rolls up as: ratio.
	measure 'Inventory Accuracy' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[accurate_positions]), SUM('dashboard_cube'[positions_counted])))
		formatString: 0.0%
		displayFolder: KPIs

	/// One minus the weighted absolute percentage error of Netstock's forecast against actual demand. Rolls up as: fixed.
	measure 'Forecast Accuracy' = IF(COUNTROWS('dashboard_cube') = 1, MAX('dashboard_cube'[forecast_accuracy]))
		formatString: 0.0%
		displayFolder: KPIs

	/// Deals won as a share of deals closed, dated on the close date. Rolls up as: ratio.
	measure 'Win Rate' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[deals_won]), SUM('dashboard_cube'[deals_closed])))
		formatString: 0.0%
		displayFolder: KPIs

	/// The amount on open deals, dated on the date each deal was created. Rolls up as: sum.
	measure 'Pipeline Value' = IF(HASONEVALUE('dashboard_cube'[Cube]), SUM('dashboard_cube'[pipeline_value]))
		formatString: \$#,0
		displayFolder: KPIs

	/// Average days from deal creation to winning it. Rolls up as: ratio.
	measure 'Sales Cycle Days' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[days_to_win_total]), SUM('dashboard_cube'[deals_won])))
		formatString: #,0.0
		displayFolder: KPIs

	/// Invoiced revenue net of credit memos, in USD. Reconciles to GL account 41000. Rolls up as: sum.
	measure Revenue = IF(HASONEVALUE('dashboard_cube'[Cube]), SUM('dashboard_cube'[revenue]))
		formatString: \$#,0
		displayFolder: KPIs

	/// The share of CRM companies the MDM provider matched to an ERP customer. A data-quality metric: the rest are crm_only and stay visible. Rolls up as: ratio.
	measure 'Customer Match Rate' = IF(HASONEVALUE('dashboard_cube'[Cube]), DIVIDE(SUM('dashboard_cube'[crm_companies_matched]), SUM('dashboard_cube'[crm_companies])))
		formatString: 0.0%
		displayFolder: KPIs

	/// Revenue over the 90 days ending on each date. Rolls up as: fixed.
	measure 'Trailing 90-day Revenue' = IF(COUNTROWS('dashboard_cube') = 1, MAX('dashboard_cube'[trailing_90d_revenue]))
		formatString: \$#,0
		displayFolder: KPIs

	/// The platform's own Azure cost, by component and environment. Rolls up as: sum.
	measure 'Platform Cloud Cost' = IF(HASONEVALUE('dashboard_cube'[Cube]), SUM('dashboard_cube'[cloud_cost]))
		formatString: \$#,0
		displayFolder: KPIs

	/// The saved query a row comes from. Filter every page or visual to one. Grains: mart_company_monthly = Month; mart_o2c = Month, Site Name; mart_i2d = Month, Site Name; mart_s2p = Month, Site Name, Supplier Name; mart_p2c = Month, Department Name; mart_f2p = Month, Site Name, Item Category Code; mart_r2p = Month; mart_department_scorecard = Month, Department Name; mart_customer_scorecard = Month, Customer Name; mart_platform_cost = Month, Component.
	column Cube
		dataType: string
		summarizeBy: none
		sourceColumn: _cube

	column Month
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: metric_time__month

	column 'Site Name'
		dataType: string
		summarizeBy: none
		sourceColumn: site__site_name

	column 'Supplier Name'
		dataType: string
		summarizeBy: none
		sourceColumn: supplier__supplier_name

	column 'Department Name'
