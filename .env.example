# Copy to .env for local overrides. Never commit .env.
# PLATFORM_ENV=local                 # local | dev | test | prod  -> config/<env>.yaml
# Any config key can be overridden as CT_<KEY>, e.g.:
# CT_MDM_PROVIDER=rules              # splink | rules
# CT_WAREHOUSE_PATH=.data/warehouse.duckdb
# CT_API_KEY=                        # require X-API-Key on the data service
# CT_ALERT_WEBHOOK=                  # Teams/Slack incoming webhook for failed runs
# TSQL_URL=mssql://sa:password@localhost:1433/warehouse   # the T-SQL path
# ANTHROPIC_API_KEY=                 # the embedded-AI example (or `ant auth login`)
